#!/bin/bash

# RpiGuiV2: hardware accelerated gui-v2 on the Raspberry Pi 2 / 3 / Zero 2 W
#
# Venus OS renders gui-v2 in software on these Raspberry Pis because
#	- /u-boot/config.txt does not load the vc4 KMS display driver (vc4-kms-v3d)
#	- the Venus OS mesa build does not include the vc4 GPU driver
#	- Qt is configured for the plain linuxfb framebuffer
#
# This package
#	- adds dtoverlay=vc4-kms-v3d and display_auto_detect=1 to /u-boot/config.txt
#		and installs the vc4-kms-v3d / vc4-kms-dsi-7inch overlays
#	- installs the mesa vc4 driver (/usr/lib/dri/vc4_dri.so, built for mesa 24.0.7)
#	- configures Qt for eglfs on the vc4 KMS device (falls back to linuxfb without it)
#	- patches display-hotplug, which assumed one connector per DRM device
#	- installs gui-v2 from the Victron package feed, in the background by the
#		RpiGuiV2Installer service (needs an internet connection)
#	- replaces the gui-v1 only service with a start-gui service, so the GUI
#		version can be selected in the settings, like on the Raspberry Pi 5
#	- optionally rotates the display by 180 degrees (setup option rotate180)
#	- makes the backlight of the official 7" display known to Venus, for
#		dimming and switching the display off when idle
#
# A reboot is needed after installing or uninstalling.
#
# See https://github.com/victronenergy/venus/issues/1305

configFile="/u-boot/config.txt"
configBeginText="#### RpiGuiV2 begin"
configEndText="#### RpiGuiV2 end"
cmdlineFile="/u-boot/cmdline.txt"
driDir="/usr/lib/dri"
installedPackagesFile="/etc/venus/RpiGuiV2-installedPackages"
stockGuiService="/opt/victronenergy/service/gui"
parkedGuiService="/opt/victronenergy/RpiGuiV2-parked/gui"
startGuiService="/opt/victronenergy/service/start-gui"
startGuiMarker="RpiGuiV2"
requiredMesa="2:24.0.7-"

# no log file for this package
packageLogFile=""

#### following line incorporates helper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources


# /u-boot/config.txt is not updated by a firmware update, so after one the lines
# are still there; the markers make it possible to remove exactly these lines
#
# disable_overscan=1: with KMS the firmware passes its default overscan to the
# kernel as 48 pixel margins, which leaves a black border on HDMI displays.
# For a TV that needs overscan: touch $setupOptionsDir/keepOverscan and reinstall

function configBlock ()
{
	echo "$configBeginText"
	echo "[all]"
	echo "dtoverlay=vc4-kms-v3d"
	echo "display_auto_detect=1"
	if ! [ -e "$setupOptionsDir/keepOverscan" ]; then
		echo "disable_overscan=1"
	fi
	echo "$configEndText"
}

function addConfigLines ()
{
	if ! [ -f "$configFile" ]; then
		setInstallFailed $EXIT_FILE_SET_ERROR "$configFile not found"
		return
	fi
	if grep -q "^$configBeginText" "$configFile"; then
		# already there: replace it only when an older version wrote other lines
		if [ "$(sed -n "/^$configBeginText/,/^$configEndText/p" "$configFile")" == "$(configBlock)" ]; then
			return
		fi
		removeConfigLines
	elif grep -q "^dtoverlay=vc4-kms-v3d" "$configFile"; then
		logMessage "$configFile already loads vc4-kms-v3d - leaving it unchanged"
		return
	fi
	logMessage "adding the vc4 KMS overlay to $configFile"
	# make sure the block starts on a new line
	if [ -n "$(tail -c 1 "$configFile")" ]; then
		echo >> "$configFile"
	fi
	configBlock >> "$configFile"
	rebootNeeded=true
}

function removeConfigLines ()
{
	if [ -f "$configFile" ] && grep -q "^$configBeginText" "$configFile"; then
		logMessage "removing the vc4 KMS overlay from $configFile"
		sed -i -e "/^$configBeginText/,/^$configEndText/d" "$configFile"
		rebootNeeded=true
	fi
}


# Rotation by 180 degrees ($setupOptionsDir/rotate180)
#
# With KMS the firmware rotation settings (display_rotate, lcd_rotate) are
# ignored, and neither gui-v2 nor Qt eglfs can rotate a Qt Quick window. The
# kernel can: video=<connector>:<mode>,rotate=180 on its command line rotates
# the display plane, and gui-v2 keeps that rotation. The vc4 hardware only
# flips, so 90 and 270 degrees are not possible.
#
# The kernel (5.10) ignores rotate=180 without a mode, so the entry repeats the
# mode the firmware passes for that connector (video=HDMI-A-1:1920x1080M@60),
# including any overscan margins. Before the vc4 driver runs there is no such
# entry and the resolution of the firmware framebuffer is used. When there are
# several video= entries for a connector the last one counts, so ours goes at
# the end. After changing to a display with another resolution, run the setup
# again. An entry for a connector that isn't there is ignored.
#
# Touch input is rotated in /etc/profile.d/qt6.sh, which checks the same option.

rotateConnectors="HDMI-A-1 DSI-1"

# the video= entry the firmware passes for connector $1, without rotate=
function firmwareVideoEntry ()
{
	tr ' ' '\n' < /proc/cmdline | grep "^video=$1:[0-9]" | grep -v "rotate=" | head -n 1
}

# the entry that rotates connector $1, empty when its mode isn't known
function rotateEntry ()
{
	local connector=$1
	local entry=$(firmwareVideoEntry $connector)
	local mode="" modesFile size
	if [ -n "$entry" ]; then
		echo "$entry,rotate=180"
		return
	fi
	modesFile=$(ls /sys/class/drm/card*-$connector/modes 2> /dev/null | head -n 1)
	if [ -n "$modesFile" ]; then
		mode=$(head -n 1 "$modesFile")
	elif [ "$connector" == "DSI-1" ]; then
		mode="800x480"		# the official 7" display
	elif [ -f /sys/class/graphics/fb0/virtual_size ]; then
		size=$(cat /sys/class/graphics/fb0/virtual_size)	# firmware framebuffer: 1920,1080
		[[ "$size" =~ ^([0-9]+),([0-9]+)$ ]] && mode="${BASH_REMATCH[1]}x${BASH_REMATCH[2]}"
	fi
	if [[ "$mode" =~ ^[0-9]+x[0-9]+ ]]; then
		echo "video=$connector:${BASH_REMATCH[0]},rotate=180"
	fi
}

# true for a rotation entry for one of our connectors (also one added by hand)
function isRotateEntry ()
{
	local connector
	for connector in $rotateConnectors; do
		[[ "$1" == video=$connector:* && "$1" == *rotate=180* ]] && return 0
	done
	return 1
}

function updateCmdline ()
{
	local add=$1
	if ! [ -f "$cmdlineFile" ]; then
		$add && logMessage "$cmdlineFile not found - can't rotate the display"
		return
	fi
	local line=$(head -n 1 "$cmdlineFile")
	local newLine="" word connector entry
	set -f
	for word in $line; do
		isRotateEntry "$word" || newLine+="${newLine:+ }$word"
	done
	set +f
	if $add; then
		for connector in $rotateConnectors; do
			entry=$(rotateEntry $connector)
			if [ -n "$entry" ]; then
				newLine+=" $entry"
			else
				logMessage "mode of $connector not known - not rotating it"
			fi
		done
	fi
	if [ "$newLine" == "$line" ]; then
		return
	fi
	if $add; then
		logMessage "rotating the display 180 degrees ($cmdlineFile)"
	else
		logMessage "removing the display rotation from $cmdlineFile"
	fi
	{ echo "$newLine"; tail -n +2 "$cmdlineFile"; } > "$cmdlineFile.new" \
		&& mv "$cmdlineFile.new" "$cmdlineFile"
	sync
	rebootNeeded=true
}


# Display backlight: dimming and screen off (official 7" touchscreen)
#
# venus-platform dims the display through /etc/venus/backlight_device and gui-v2
# switches it off through /etc/venus/blank_display_device. The raspberrypi2
# firmware has neither, so both were "not supported". The backlight device only
# exists with the 7" display connected and its name depends on the driver, so
# the files link to /run/RpiGuiV2, written at boot by a udev rule
# (/lib/udev/rpiguiv2-backlight). Without a backlight the links point to nothing,
# which Venus treats as "not supported", as before.

venusConfDir="/etc/venus"
backlightRunDir="/run/RpiGuiV2"
backlightFeatures="backlight_device blank_display_device"

function installBacklight ()
{
	local feature link linked=false
	for feature in $backlightFeatures; do
		link="$venusConfDir/$feature"
		if [ -L "$link" ] && [ "$(readlink "$link")" == "$backlightRunDir/$feature" ]; then
			continue
		elif [ -f "$link" ] && ! [ -L "$link" ] && ! [ -e "$(head -n 1 "$link")" ]; then
			# a file pointing to a device that isn't there, e.g. rpi_backlight written
			# by RpiDisplaySetup: that firmware backlight doesn't exist under KMS
			logMessage "replacing $link: $(head -n 1 "$link") does not exist"
			rm -f "$link"
		elif [ -e "$link" ] || [ -L "$link" ]; then
			logMessage "$link is provided by the firmware - leaving it unchanged"
			continue
		fi
		logMessage "linking $link to $backlightRunDir/$feature"
		ln -s "$backlightRunDir/$feature" "$link"
		linked=true
	done
	# record a backlight that is already there (the rule only runs at boot otherwise)
	udevadm control --reload 2> /dev/null
	udevadm trigger --subsystem-match=backlight --action=add 2> /dev/null
	udevadm settle --timeout=5 2> /dev/null
	if [ -s "$backlightRunDir/backlight_device" ]; then
		logMessage "display backlight: $(cat "$backlightRunDir/backlight_device")"
		# venus-platform reads backlight_device once at start and only then
		# creates the brightness setting
		if $linked && [ -d /service/venus-platform ]; then
			svc -t /service/venus-platform
		fi
		# gui-v2 reads blank_display_device once at start
		if $linked && [ -d /service/start-gui ]; then
			svc -t /service/start-gui
		fi
	fi
}

function removeBacklight ()
{
	local feature link
	for feature in $backlightFeatures; do
		link="$venusConfDir/$feature"
		if [ -L "$link" ] && [ "$(readlink "$link")" == "$backlightRunDir/$feature" ]; then
			logMessage "removing $link"
			rm -f "$link"
		fi
	done
	rm -rf "$backlightRunDir"
}


# a firmware that already has a start-gui service (like the Raspberry Pi 5) can
# switch between gui-v1 and gui-v2 itself: leave its services alone then

function stockStartGuiPresent ()
{
	[ -d "$startGuiService" ] && ! grep -q "$startGuiMarker" "$startGuiService/run" 2> /dev/null
}

# the stock gui service (package start-gui-v1) only runs gui-v1. It is moved out
# of the service directory while this package is installed. It is on the root
# file system, so a firmware update restores it and the reinstall parks it again.

function parkStockGuiService ()
{
	if [ -d "$stockGuiService" ]; then
		logMessage "parking the stock gui-v1 service"
		mkdir -p "$(dirname "$parkedGuiService")"
		rm -rf "$parkedGuiService"
		mv "$stockGuiService" "$parkedGuiService"
	fi
	if [ -d /service/gui ]; then
		svc -dx /service/gui /service/gui/log 2> /dev/null
		rm -rf /service/gui
	fi
}

function restoreStockGuiService ()
{
	if [ -d "$parkedGuiService" ]; then
		logMessage "restoring the stock gui-v1 service"
		rm -rf "$stockGuiService"
		mv "$parkedGuiService" "$stockGuiService"
		rmdir "$(dirname "$parkedGuiService")" 2> /dev/null
	fi
	# /service is a tmpfs copy of the service directory made at boot
	if [ -d "$stockGuiService" ] && ! [ -d /service/gui ]; then
		mkdir -p /service/gui
		cp -a "$stockGuiService"/* /service/gui
	fi
}

# the start-gui service is kept outside the services directory and installed
# here, so SetupHelper never removes a start-gui service it didn't install

function installStartGuiService ()
{
	logMessage "installing the start-gui service"
	rm -rf "$startGuiService"
	cp -R "$scriptDir/startGuiService" "$startGuiService"
	if [ -d /service/start-gui ]; then
		# update of this package: replace the running copy and restart it
		cp "$scriptDir/startGuiService/run" /service/start-gui/run
		cp "$scriptDir/startGuiService/log/run" /service/start-gui/log/run
		svc -t /service/start-gui
	else
		cp -R "$scriptDir/startGuiService" /service/start-gui
	fi
}

function removeStartGuiService ()
{
	if [ -d "$startGuiService" ] && grep -q "$startGuiMarker" "$startGuiService/run" 2> /dev/null; then
		logMessage "removing the start-gui service"
		svc -dx /service/start-gui /service/start-gui/log 2> /dev/null
		rm -rf "$startGuiService" /service/start-gui
	fi
}

function selectGuiV2 ()
{
	logMessage "selecting gui-v2 for the local display"
	dbus-send --system --print-reply --dest=com.victronenergy.settings /Settings \
		com.victronenergy.Settings.AddSetting string:Gui string:RunningVersion \
		variant:int32:1 string:i variant:int32:1 variant:int32:2 &> /dev/null
	dbus-send --system --print-reply --dest=com.victronenergy.settings /Settings/Gui/RunningVersion \
		com.victronenergy.BusItem.SetValue variant:int32:2 &> /dev/null
}

# remove the packages the RpiGuiV2Installer service installed, nothing else
function removeGuiV2Packages ()
{
	if ! [ -s "$installedPackagesFile" ]; then
		return
	fi
	local remaining=( $(cat "$installedPackagesFile") )
	logMessage "removing packages installed for gui-v2: ${remaining[*]}"
	# packages that others still depend on are refused by opkg, so keep
	# removing until no more progress is made
	local passes=${#remaining[@]}
	while (( ${#remaining[@]} > 0 && passes > 0 )); do
		local left=()
		local package
		for package in "${remaining[@]}"; do
			if opkg list-installed "$package" | grep -q "^$package " && ! opkg remove "$package" &> /dev/null; then
				left+=( "$package" )
			fi
		done
		remaining=( "${left[@]}" )
		(( passes-- ))
	done
	if (( ${#remaining[@]} > 0 )); then
		logMessage "could not remove: ${remaining[*]}"
	fi
	rm -f "$installedPackagesFile"
}


#### running manually and OK to proceed - prompt for input
if [ $scriptAction == 'NONE' ] ; then
	echo
	echo "Hardware accelerated gui-v2 for the Raspberry Pi 2 / 3 / Zero 2 W:"
	echo "  - loads the vc4 KMS display driver (/u-boot/config.txt)"
	echo "  - installs the mesa vc4 GPU driver and configures Qt for it"
	echo "  - installs gui-v2 from the Victron package feed (needs internet, runs in the background)"
	echo "  - adds start-gui so gui-v1 or gui-v2 can be selected in the settings"
	echo "A reboot is needed afterwards."

	standardActionPrompt 'MORE_PROMPTS'

	if [ $scriptAction == 'NONE' ]; then
		echo
		if yesNoPrompt "Show gui-v2 on the local display (y) or keep gui-v1 for now (n)?: " ; then
			rm -f "$setupOptionsDir/keepGuiV1"
		else
			touch "$setupOptionsDir/keepGuiV1"
		fi
		if yesNoPrompt "Rotate the display 180 degrees (y/n)?: " ; then
			touch "$setupOptionsDir/rotate180"
		else
			rm -f "$setupOptionsDir/rotate180"
		fi
		scriptAction='INSTALL'
	fi
fi

#### installing
if [ $scriptAction == 'INSTALL' ] ; then
	if [ "$machine" != "raspberrypi2" ]; then
		setInstallFailed $EXIT_INCOMPATIBLE_PLATFORM \
			"RpiGuiV2 is for the Raspberry Pi 2 / 3 / Zero 2 W (raspberrypi2), not $machine"
	fi
	if ! $installFailed; then
		mesa=$(opkg list-installed libgbm1 2> /dev/null | awk '{ print $3 }')
		if [[ "$mesa" != "$requiredMesa"* ]]; then
			setInstallFailed $EXIT_INCOMPATIBLE_VERSION \
				"the included vc4 driver is built for mesa 24.0.7, this firmware has ${mesa:-no mesa}"
		fi
	fi

	if ! $installFailed; then
		# updateActiveFile skips files whose directory doesn't exist
		mkdir -p "$driDir"
		addConfigLines
	fi
	if ! $installFailed; then
		if [ -e "$setupOptionsDir/rotate180" ]; then
			updateCmdline true
		else
			updateCmdline false
		fi
	fi

	if ! $installFailed; then
		if stockStartGuiPresent; then
			logMessage "this firmware has its own start-gui service - using it"
		else
			parkStockGuiService
			installStartGuiService
		fi
		installService RpiGuiV2Installer
		# the udev rule and its helper have to be in place for installBacklight
		mkdir -p /lib/udev/rules.d
		installAllFiles
	fi
	if ! $installFailed; then
		installBacklight
		# a reinstall after a firmware update keeps the choice made in the settings
		if ! $reinstall && ! [ -e "$setupOptionsDir/keepGuiV1" ]; then
			selectGuiV2
		fi
	fi
fi

# uninstalling - check scriptAction again
# if an install step failed package needs to be removed
if [ $scriptAction == 'UNINSTALL' ] ; then
	# stop a gui-v2 install that may be in progress before removing packages
	removeService RpiGuiV2Installer
	removeGuiV2Packages
	removeStartGuiService
	restoreStockGuiService
	removeBacklight
	removeConfigLines
	updateCmdline false
	uninstallAllFiles
	rmdir "$driDir" 2> /dev/null
fi

# thats all folks - SCRIPT EXITS INSIDE THE FUNCTION
endScript 'INSTALL_FILES'
